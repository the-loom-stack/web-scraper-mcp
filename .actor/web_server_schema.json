{
  "openapi": "3.0.3",
  "info": {
    "title": "Web Scraper MCP Server",
    "description": "MCP-compatible HTTP server for batch web scraping. Connect any MCP client to the /mcp endpoint.",
    "version": "1.0.0"
  },
  "paths": {
    "/mcp": {
      "post": {
        "summary": "MCP endpoint",
        "description": "Model Context Protocol endpoint. Accepts MCP JSON-RPC requests and returns MCP responses. Compatible with Claude Desktop, Cursor, Cline, and all MCP clients.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "jsonrpc": { "type": "string", "example": "2.0" },
                  "method": { "type": "string", "example": "tools/call" },
                  "id": { "type": "string" },
                  "params": { "type": "object" }
                },
                "required": ["jsonrpc", "method"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP JSON-RPC response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jsonrpc": { "type": "string" },
                    "id": { "type": "string" },
                    "result": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns server health status.",
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
