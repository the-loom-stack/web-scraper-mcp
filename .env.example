# Local development only — these are auto-injected on the Apify platform

# Your Apify API token (get it from https://console.apify.com/account/integrations)
APIFY_API_TOKEN=your_apify_token_here

# Server port (Apify Standby injects ACTOR_STANDBY_PORT automatically)
PORT=3000

NODE_ENV=development

# Optional: set to 'true' to route scraped requests through Apify Proxy
# Helps with bot-protected sites. Incurs additional proxy credit costs.
# APIFY_USE_PROXY=true
